<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="package cost calculator"/>
        <attribute name="authors" value="kh98l"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-17 09:42:47 AM"/>
        <attribute name="created" value="a2g5OGw7S0hBRkxJOzIwMjYtMDktMTA7MDY6MjM6MzQgQU07MjEzMA=="/>
        <attribute name="edited" value="a2g5OGw7S0hBRkxJOzIwMjYtMDktMTc7MDk6NDI6NDcgQU07NjsyMjU4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="berat, jarak, hargaservis, hargaberat, hargajarak, hargatotal" type="Real" array="False" size=""/>
            <declare name="jenisservis, ulang" type="Integer" array="False" size=""/>
            <do expression="ulang == 1">
                <output expression="&quot;Berapa berat benda yang ingin dikirim dalam kg ?&quot;" newline="True"/>
                <input variable="berat"/>
                <output expression="&quot;Berapa jarak pengirimannya dalam km ?&quot;" newline="True"/>
                <input variable="jarak"/>
                <do expression="jenisservis != 1 &amp;&amp; jenisservis != 2">
                    <output expression="&quot;Servis apa yang ingin anda gunakan?&quot; &amp; ToChar(13) &amp; &quot;1 = Reguler&quot; &amp; ToChar(13) &amp; &quot;2 = Ekspres&quot;" newline="True"/>
                    <input variable="jenisservis"/>
                    <if expression="jenisservis != 1 &amp;&amp; jenisservis != 2">
                        <then>
                            <output expression="&quot;Pilihan invalid coba lagi&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </do>
                <if expression="berat &gt; 1">
                    <then>
                        <if expression="jenisservis == 1">
                            <then>
                                <assign variable="hargaberat" expression="int(1+(berat-1)*2)"/>
                            </then>
                            <else>
                                <assign variable="hargaberat" expression="int(1+(berat-1)*3)"/>
                            </else>
                        </if>
                    </then>
                    <else>
                        <assign variable="hargaberat" expression="1"/>
                    </else>
                </if>
                <if expression="jenisservis == 1">
                    <then>
                        <assign variable="hargaservis" expression="5"/>
                    </then>
                    <else>
                        <assign variable="hargaservis" expression="10"/>
                    </else>
                </if>
                <if expression="jarak &gt; 10">
                    <then>
                        <if expression="jenisservis == 1">
                            <then>
                                <assign variable="hargajarak" expression="int(1+(jarak/10)*2)"/>
                            </then>
                            <else>
                                <assign variable="hargajarak" expression="int(1+(jarak/10)*2)"/>
                            </else>
                        </if>
                    </then>
                    <else>
                        <assign variable="hargajarak" expression="1"/>
                    </else>
                </if>
                <assign variable="hargatotal" expression="hargaservis + hargaberat + hargajarak"/>
                <output expression="&quot;Untuk total harga pengantaran paketnya adalah $&quot; &amp; hargatotal &amp; ToChar(13)&amp; &quot;Untuk harga servis paketnya adalah $&quot; &amp; hargaservis &amp; ToChar(13)&amp; &quot;Untuk harga berat paketnya adalah $&quot; &amp; hargaberat &amp; ToChar(13)&amp; &quot;Untuk harga jarak paketnya adalah $&quot; &amp; hargajarak" newline="True"/>
                <output expression="&quot;Hitung biaya paket lain? 1= iya 2= tidak&quot;" newline="True"/>
                <input variable="ulang"/>
            </do>
        </body>
    </function>
</flowgorithm>
