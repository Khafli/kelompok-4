<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="package cost calculator"/>
        <attribute name="authors" value="kh98l"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-10 03:24:36 PM"/>
        <attribute name="created" value="a2g5OGw7S0hBRkxJOzIwMjYtMDktMTA7MDY6MjM6MzQgQU07MjEzMA=="/>
        <attribute name="edited" value="a2g5OGw7S0hBRkxJOzIwMjYtMDktMTA7MDM6MjQ6MzYgUE07MzsyMjU1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="berat, jarak, hargaservis, hargaberat, hargajarak, hargatotal" type="Real" array="False" size=""/>
            <declare name="jenisservis" type="Integer" array="False" size=""/>
            <output expression="&quot;Servis apa yang ingin anda gunakan?&quot; &amp; ToChar(13) &amp; &quot;1 = Reguler&quot; &amp; ToChar(13) &amp; &quot;2 = Ekspres&quot;" newline="True"/>
            <input variable="jenisservis"/>
            <output expression="&quot;Berapa berat benda yang ingin dikirim dalam kg ?&quot;" newline="True"/>
            <input variable="berat"/>
            <output expression="&quot;Berapa jarak pengirimannya dalam km ?&quot;" newline="True"/>
            <input variable="jarak"/>
            <if expression="berat &gt; 1">
                <then>
                    <if expression="jenisservis == 1">
                        <then>
                            <assign variable="hargaberat" expression="int(2+(berat-1)*2)"/>
                        </then>
                        <else>
                            <assign variable="hargaberat" expression="int(2+(berat-1)*3)"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="hargaberat" expression="(int(berat-1)*2)"/>
                </else>
            </if>
            <if expression="jenisservis == 1">
                <then>
                    <assign variable="hargaservis" expression="5"/>
                </then>
                <else>
                    <assign variable="hargaservis" expression="10"/>
                </else>
            </if>
            <if expression="jarak &gt; 10">
                <then>
                    <if expression="jenisservis == 1">
                        <then>
                            <assign variable="hargajarak" expression="int(1+(jarak/10)*2)"/>
                        </then>
                        <else>
                            <assign variable="hargajarak" expression="int(1+(jarak/10)*2)"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="hargajarak" expression="1"/>
                </else>
            </if>
            <assign variable="hargatotal" expression="hargaservis + hargaberat + hargajarak"/>
            <output expression="&quot;Untuk total harga pengantaran paketnya adalah $&quot; &amp; hargatotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
